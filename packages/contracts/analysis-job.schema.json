{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-investment-advisor.local/contracts/analysis-job.schema.json",
  "title": "AnalysisJobRequest",
  "type": "object",
  "required": [
    "run_id",
    "user_id",
    "thread_id",
    "analysis_mode",
    "target_type",
    "target_value",
    "question",
    "risk_profile",
    "preferred_language",
    "selected_skill_profile"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "analysis_mode": {
      "type": "string",
      "enum": ["deep_report", "quick_scan", "theme_research"]
    },
    "target_type": {
      "type": "string",
      "enum": ["ticker", "theme", "question"]
    },
    "target_value": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "risk_profile": {
      "type": "string",
      "enum": ["conservative", "balanced", "aggressive"]
    },
    "preferred_language": {
      "type": "string",
      "enum": ["zh-CN", "en-US"]
    },
    "selected_skill_profile": {
      "type": "string"
    }
  }
}
